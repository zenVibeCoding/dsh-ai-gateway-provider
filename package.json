{
  "name": "dsh-ai-gateway-provider",
  "version": "0.7.1",
  "description": "Any OpenAI-compatible gateway for DeepSeek Harness: probe it, save it, manage its models; known backends also report quota.",
  "license": "MIT",
  "author": "zenVibeCoding",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ai-gateway",
    "openai-compatible",
    "llm-provider",
    "new-api",
    "cliproxy",
    "litellm",
    "one-api"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "PUBLISHING.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "probe": "node scripts/probe.mjs"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@earendil-works/pi-ai": ">=1.0.0 <2.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm-pi-ai": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zenVibeCoding/dsh-ai-gateway-provider.git"
  },
  "homepage": "https://github.com/zenVibeCoding/dsh-ai-gateway-provider#readme",
  "bugs": {
    "url": "https://github.com/zenVibeCoding/dsh-ai-gateway-provider/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
