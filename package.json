{
  "name": "dsh-ai-gateway-provider",
  "version": "0.4.2",
  "description": "Standard-first gateway provider for DeepSeek Harness: any OpenAI-compatible endpoint works, and known backends also report quota.",
  "license": "MIT",
  "author": "zenVibeCoding",
  "private": true,
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ai-gateway",
    "openai-compatible",
    "llm-provider"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "probe": "node scripts/probe.mjs"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@earendil-works/pi-ai": ">=1.0.0 <2.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm-pi-ai": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
